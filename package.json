{
  "name": "izer",
  "productName": "IZER",
  "description": "IZER - Indian Papercraft Parametric EQ Studio",
  "author": "satyakesavakorlapati <korlapatisatyakesava@gmail.com>",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/bundle-drive-api.cjs && vite build",
    "bundle:drive-api": "node scripts/bundle-drive-api.cjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check": "esbuild src/eq/selfcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/selfcheck.mjs && node node_modules/.tmp/selfcheck.mjs",
    "electron:start": "electron .",
    "electron:dev": "electron .",
    "bundle:win": "npm run build && electron-builder --win",
    "bundle:mac": "npm run build && electron-builder --mac",
    "bundle:linux": "npm run build && electron-builder --linux",
    "bundle:all": "npm run build && electron-builder -mwl",
    "build:electron": "npm run build && electron-builder",
    "fast:build": "node scripts/fast_pack.cjs"
  },
  "build": {
    "appId": "com.izer.app",
    "productName": "IZER",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IZER",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
